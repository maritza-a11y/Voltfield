# =====================================================================
# Environment variables — copy to .env and fill in real values.
# .env is git-ignored and must NEVER be committed.
# Only VITE_-prefixed vars are exposed to the browser bundle.
# =====================================================================

# Supabase — Settings > API in your Supabase project dashboard.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps JavaScript API key (Maps JS API + Geocoding API enabled).
# Restrict by HTTP referrer in Google Cloud Console for production.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
